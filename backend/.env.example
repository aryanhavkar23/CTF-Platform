# ==============================================================================
# OWASP CTF Platform - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and customize for your local or production environment.
# NEVER commit real credentials or production secret keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Debugging
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Secret Key & JWT Settings
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random string with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production, SECRET_KEY must be >= 32 characters and cannot equal default placeholders.
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_owasp_ctf_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL primary)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/owasp_ctf
TEST_DATABASE_URL=sqlite:///./test.db

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. CORS & Security Headers
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins.
# In production, do NOT use "*" when CORS_ALLOW_CREDENTIALS=True.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
ENABLE_HSTS=false

# ------------------------------------------------------------------------------
# 5. File Upload Safeguards
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (default 50MB = 52428800)
MAX_FILE_UPLOAD_SIZE=52428800

# ------------------------------------------------------------------------------
# 6. Submission Rate Limiting & Anti-Cheat
# ------------------------------------------------------------------------------
SUBMISSION_RATE_LIMIT_PER_MINUTE=10
SUBMISSION_COOLDOWN_SECONDS=2
ANTI_CHEAT_WINDOW_MINUTES=10
BURST_SUBMISSION_THRESHOLD=15
SOLVE_VELOCITY_THRESHOLD=4
FAILED_SUBMISSIONS_THRESHOLD=20

# ------------------------------------------------------------------------------
# 7. Live Docker Challenges Infrastructure (Phase 15)
# ------------------------------------------------------------------------------
DOCKER_BASE_URL=
DOCKER_NETWORK=ctf_challenges_net
CHALLENGE_PORT_RANGE_START=30000
CHALLENGE_PORT_RANGE_END=31000
CHALLENGE_DEFAULT_DURATION_MINUTES=30
CHALLENGE_MAX_DURATION_MINUTES=60
CHALLENGE_MAX_CONTAINERS_PER_USER=2
CHALLENGE_MAX_TOTAL_CONTAINERS=50
CHALLENGE_CONTAINER_CPU_LIMIT=0.5
CHALLENGE_CONTAINER_MEM_LIMIT=256m
CHALLENGE_CONTAINER_PIDS_LIMIT=100
CHALLENGE_PUBLIC_HOST=localhost
